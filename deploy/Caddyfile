{$APP_DOMAIN} {
    request_body {
        max_size 6MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        -Server
    }
    @api path /api/v1/* /media/*
    handle @api {
        reverse_proxy api:3001
    }
    handle {
        reverse_proxy web:3000
    }
}
